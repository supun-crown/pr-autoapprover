GITHUB_TOKEN=ghp_xxx
GITHUB_OWNER=your-org

# Recommended: list your real repos here instead of editing src/repos.ts.
# This keeps your service names out of source control.
# GITHUB_REPOS=api-gateway,frontend,worker

# Poll interval (default 60000)
# POLL_INTERVAL_MS=30000

# Dry-run mode: log intended actions, don't post anything
# DRY_RUN=true

# Path to the claude CLI (default: "claude" on PATH)
# CLAUDE_BIN=claude
# Per-PR claude timeout (default 90000)
# CLAUDE_TIMEOUT_MS=90000

# GIF behaviour
# GIF_PROBABILITY=0.5         # 0.0 = never, 1.0 = always
# GIF_THEME=lgtm celebration ship-it
# GIF_MAX_ROUNDS=3            # claude retry rounds searching for a valid GIF
